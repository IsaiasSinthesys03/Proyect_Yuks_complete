# ============================================================
# Animayuks API Backend — Variables de Entorno
# Fase 26: Composition Root Final — Copia este archivo a .env
# ============================================================

# ────────────────────────────────────────────────────────────
# SERVIDOR
# ────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# CORS (Fase 34): allowlist de orígenes del Frontend, separados por coma.
# NADA de "*": un Origin fuera de esta lista NO recibe cabeceras CORS.
FRONTEND_URL="http://localhost:5173"

# ────────────────────────────────────────────────────────────
# BASE DE DATOS (PostgreSQL / Supabase)
# ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/animayuks?schema=public"

# ────────────────────────────────────────────────────────────
# CACHÉ / COLAS (Redis + BullMQ)
# Requerido para: idempotencia, distributed locks, DLQ de pagos.
# ────────────────────────────────────────────────────────────
REDIS_URL="redis://127.0.0.1:6379"
REDIS_LOG_THROTTLE_MS="60000"

# ────────────────────────────────────────────────────────────
# AUTENTICACIÓN JWT — Clientes
# ────────────────────────────────────────────────────────────
JWT_SECRET="CAMBIA_ESTO_POR_UN_SECRETO_SEGURO_DE_AL_MENOS_32_CARACTERES"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="CAMBIA_ESTO_POR_OTRO_SECRETO_DISTINTO_AL_JWT_SECRET_DE_AL_MENOS_32_CARACTERES"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ────────────────────────────────────────────────────────────
# AUTENTICACIÓN JWT — Administradores (CMS)
# ADMIN_ALLOWED_IPS: IPs con acceso al CMS (separadas por coma).
#   En dev: 127.0.0.1,::1,::ffff:127.0.0.1
#   En producción: IPs estáticas de la VPN o el servidor CMS frontend.
# ────────────────────────────────────────────────────────────
ADMIN_JWT_EXPIRES_IN="8h"
ADMIN_ALLOWED_IPS="127.0.0.1,::1,::ffff:127.0.0.1"

# ────────────────────────────────────────────────────────────
# RATE LIMITING (Fase 26)
# Límite global de solicitudes por IP por minuto.
# Las rutas admin/auth aplican su propio límite estricto (5/min).
# ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=200

# ────────────────────────────────────────────────────────────
# PASARELA DE PAGOS — Stripe
# ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_CAMBIA_ESTO_CON_TU_LLAVE_DE_STRIPE"
STRIPE_WEBHOOK_SECRET="whsec_CAMBIA_ESTO_CON_TU_WEBHOOK_SECRET"

# ────────────────────────────────────────────────────────────
# GAME BRIDGE M2M (Game API de Recompensas Virtuales)
# GAME_M2M_SECRET: Secreto compartido para validar el token M2M
#   recibido del servidor de juego (Bearer estático).
# ────────────────────────────────────────────────────────────
GAME_API_BASE_URL="http://localhost:4000"
GAME_API_M2M_TOKEN="your-m2m-static-token"
GAME_M2M_SECRET="your-m2m-validation-secret"

# ────────────────────────────────────────────────────────────
# ALMACENAMIENTO DE MEDIOS — AWS S3 (Fase 23)
# El servidor arranca aunque falten estas variables (graceful degradation):
#   los uploads de imagen retornan HTTP 503 hasta configurarlas.
# ────────────────────────────────────────────────────────────
S3_BUCKET="animayuks-media"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
S3_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

# ────────────────────────────────────────────────────────────
# EMAIL TRANSACCIONAL — Resend (Fase 28, REQ-BE-04)
# EMAIL_API_KEY:  clave de API de Resend (https://resend.com/api-keys).
# EMAIL_FROM:     dirección "De:" de los correos (debe estar verificada en Resend).
# EMAIL_REPLY_TO: dirección de respuesta (opcional).
# NOTA: el servidor HTTP NUNCA llama a Resend directamente — el envío
#       ocurre en el proceso separado "worker:email" (BullMQ consumer).
# ────────────────────────────────────────────────────────────
EMAIL_API_KEY="re_CAMBIA_ESTO_CON_TU_API_KEY_DE_RESEND"
EMAIL_FROM="Animayuks <noreply@animayuks.com>"
EMAIL_REPLY_TO="soporte@animayuks.com"

# ────────────────────────────────────────────────────────────
# AUTH AVANZADA (Fase 29) — Recuperación, OAuth, 2FA
# ────────────────────────────────────────────────────────────
# PASSWORD_RESET_URL: base del enlace de recuperación que se envía por correo.
#   El backend le añade ?token=<token>. Debe apuntar a la pantalla del frontend.
PASSWORD_RESET_URL="http://localhost:5173/reset-password"

# TOTP_ISSUER: nombre que muestran Google Authenticator / Authy para el 2FA admin.
TOTP_ISSUER="Animayuks CMS"

# Google OAuth 2.0 — credenciales de la consola de Google Cloud.
#   El servidor arranca sin ellas (login social responde 502 hasta configurarlas).
#   GOOGLE_REDIRECT_URI debe coincidir EXACTAMENTE con la registrada en Google.
GOOGLE_CLIENT_ID="CAMBIA_ESTO.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="CAMBIA_ESTO_CON_TU_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/oauth/google/callback"

# ────────────────────────────────────────────────────────────
# REPORTES ASÍNCRONOS (Fase 31, CMS-BE-05)
# REPORTS_DIR: carpeta donde el worker escribe los CSV y la API los sirve.
#   DEBE ser accesible por ambos procesos (mismo volumen). Por defecto ./reports
# ────────────────────────────────────────────────────────────
REPORTS_DIR="./reports"

# TODO: STRIPE — true = pagos simulados (sin claves); false = StripeAdapter real
PAYMENTS_SIMULATED=false
