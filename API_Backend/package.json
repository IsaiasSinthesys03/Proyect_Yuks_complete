{
  "name": "api_backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/main.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/infrastructure/database/migrate.ts",
    "redis:up": "docker compose -f compose.redis.yml up -d --wait",
    "redis:down": "docker compose -f compose.redis.yml down",
    "redis:logs": "docker compose -f compose.redis.yml logs -f redis",
    "worker:reconciliation": "tsx watch src/infrastructure/queues/workers/payment-reconciliation.worker.ts",
    "worker:email": "tsx watch src/infrastructure/queues/workers/email.worker.ts",
    "worker:reports": "tsx watch src/infrastructure/queues/workers/reports.worker.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1076.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/websocket": "^11.2.0",
    "@sentry/node": "^10.69.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.78.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "file-type": "^16.5.4",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.2",
